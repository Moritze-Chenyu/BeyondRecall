{
  "protocol_version": "3.2",
  "dataset": {
    "name": "Beyond Recall",
    "expected_trajectories": 1163,
    "expected_questions": 1269,
    "expected_sessions": 23775,
    "dimensions": [
      "retrieval",
      "reasoning",
      "management"
    ],
    "task_count": 11,
    "target_person_rule": "persons[0]"
  },
  "protocol": {
    "random_seed": 42,
    "chronological_ingestion": true,
    "state_isolation": "one fresh system instance per question",
    "parallelism_unit": "question_with_isolated_namespace",
    "default_workers": 1,
    "inference_and_judging": "separate immutable stages",
    "strict_error_policy": "execution, media, API, empty-answer, and judge-parsing failures count as incorrect",
    "primary_metric": "strict_micro_accuracy",
    "secondary_metrics": [
      "task_macro_accuracy",
      "dimension_accuracy",
      "task_accuracy",
      "Wilson 95% confidence interval",
      "Any-Hit@K when private evidence annotations are available",
      "CESA@K when private evidence annotations are available",
      "Accuracy given CESA when private evidence annotations are available"
    ],
    "persist_adapter_diagnostics": true,
    "reference_answers_visible_to_system": false,
    "task_labels_visible_to_system": false,
    "evidence_annotations_visible_to_system": false,
    "source_identifiers_visible_to_system": false,
    "timestamp_policy": "inclusive history cutoff before any ingestion; chronological UTC-normalized order"
  },
  "models": {
    "answer": {
      "model": "SET_YOUR_PROVIDER_MODEL_ID",
      "revision": "provider-release-required",
      "revision_env": "BEYOND_RECALL_ANSWER_REVISION",
      "chat_template_revision": "provider-release-required",
      "api_key_env": "BR_API_KEY",
      "base_url_env": "BR_API_BASE_URL",
      "temperature": 0,
      "enable_thinking": false,
      "max_tokens": 1024,
      "timeout_seconds": 300,
      "max_retries": 2,
      "backend": "api",
      "visual_transport": "all_frames_lossless_tiles",
      "visual_tile_size": 896,
      "visual_padding_factor": 224,
      "visual_minimum_side": 224,
      "require_verified_processing": false,
      "provider_processing_report": null
    },
    "memory_extraction_and_evolution": {
      "model": "Qwen/Qwen3.5-35B-A3B",
      "revision": "UNPINNED_CONFIGURE_IF_USED",
      "revision_env": "BEYOND_RECALL_MEMORY_REVISION",
      "chat_template_revision": "provider-pinned-main-evaluation",
      "api_key_env": "BEYOND_RECALL_MEMORY_API_KEY",
      "base_url_env": "BEYOND_RECALL_MEMORY_BASE_URL",
      "temperature": 0,
      "enable_thinking": false,
      "max_tokens": 2048,
      "timeout_seconds": 300,
      "max_retries": 6
    },
    "caption": {
      "model": "Qwen/Qwen3.5-35B-A3B",
      "revision": "UNPINNED_CONFIGURE_IF_USED",
      "revision_env": "BEYOND_RECALL_CAPTION_REVISION",
      "chat_template_revision": "provider-pinned-main-evaluation",
      "api_key_env": "BEYOND_RECALL_CAPTION_API_KEY",
      "base_url_env": "BEYOND_RECALL_CAPTION_BASE_URL",
      "temperature": 0,
      "enable_thinking": false,
      "max_tokens": 1024,
      "timeout_seconds": 300,
      "max_retries": 6,
      "shared_frozen_cache": true
    },
    "judge": {
      "model": "SET_YOUR_PROVIDER_MODEL_ID",
      "revision": "provider-pinned-main-evaluation",
      "revision_env": "BEYOND_RECALL_JUDGE_REVISION",
      "chat_template_revision": "provider-pinned-main-evaluation",
      "api_key_env": "BR_JUDGE_API_KEY",
      "base_url_env": "BR_JUDGE_BASE_URL",
      "temperature": 0,
      "max_tokens": 512,
      "timeout_seconds": 180,
      "max_retries": 2,
      "retry_base_delay_seconds": 5,
      "backend": "api"
    },
    "text_embedding": {
      "model": "BAAI/bge-small-en-v1.5",
      "revision": "UNPINNED_CONFIGURE_IF_USED",
      "revision_env": "BEYOND_RECALL_TEXT_EMBED_REVISION",
      "dimension": 384,
      "pooling": "model-default-cls",
      "normalize": true,
      "query_instruction": "",
      "maximum_tokens": 512,
      "distance": "cosine"
    },
    "multimodal_embedding": {
      "model": "Qwen/Qwen3-VL-Embedding-8B",
      "revision": "UNPINNED_CONFIGURE_IF_USED",
      "revision_env": "BEYOND_RECALL_MM_EMBED_REVISION",
      "dimension": 1024,
      "normalize": true,
      "maximum_tokens": 32768,
      "distance": "cosine"
    }
  },
  "media_processing": {
    "quality": {
      "pdf_render_dpi": 300,
      "native_file_types": [],
      "video_transport": "unsupported",
      "spreadsheet_mode": "complete_xml_and_render",
      "pdf_mode": "core_pdf_remaining_text",
      "pdf_visual_pages": 10,
      "pdf_ocr_missing_text": true,
      "pdf_ocr_language": "eng"
    },
    "image": {
      "preserve_source_bytes": true,
      "resize": false
    },
    "pdf": {
      "memory_input": "core_pdf_file_and_remaining_pages_text",
      "core_page_budget": 10,
      "split_before_framework_ingestion": true,
      "core_text_duplicated_in_memory": false
    },
    "video": {
      "sampling": false,
      "preserve_audio": true,
      "unsupported_backend_action": "error"
    },
    "capacity_policy": "explicit PDF core-page representation plus unabridged text; no additional silent truncation or resizing"
  },
  "retrieval_defaults": {
    "unit": "session",
    "final_top_k": 10,
    "dense_candidates": 10,
    "lexical_candidates": 10,
    "hybrid_fusion": "reciprocal_rank_fusion",
    "rrf_k": 60,
    "deduplication_key": "opaque_session_unit_id",
    "bm25": {
      "tokenizer": "lowercase_ascii_alphanumeric",
      "k1": 1.5,
      "b": 0.75
    }
  },
  "prompts": {
    "answer": "Answer the question using only the supplied conversation history, retrieved sessions, or explicit memories. If the available information is insufficient, state that it cannot be determined. Give a concise answer.",
    "image_caption": "Objectively describe visible entities, attributes, states, readable text, chart values, and spatial relationships useful for later memory question answering. Do not invent information.",
    "video_caption": "Describe the video in chronological order. Preserve observable people, objects, locations, actions, counts, state changes, intent cues, and temporal order. Distinguish uncertainty from observed facts.",
    "pdf_caption": "Describe the supplied PDF pages with page numbers. Preserve headings, table and chart values, entities, relations, and details needed for later question answering.",
    "history_serialization": "Chronological sessions with timestamps and speaker turns; preserve each media reference, attach complete assets once within selected evidence.",
    "answer_message_roles": [
      "system: fixed benchmark answering instruction",
      "user: serialized history or retrieved memory followed by the question"
    ]
  },
  "judge_rubrics": {
    "default": "The key factual content must agree with the reference answer. Additional non-contradictory explanation is allowed.",
    "high_density_information_extraction": "All values, entities, comparisons, and requested list items needed by the question must be correct.",
    "long_term_semantic_summary": "The response must preserve the reference conclusion and the central long-term pattern; minor wording differences are allowed.",
    "conflict_detection": "The response must identify the relevant incompatibility or contradiction and reach the reference decision.",
    "refusal_to_answer": "The response must abstain when the reference indicates insufficient evidence and must not invent an answer."
  },
  "method_profiles": {
