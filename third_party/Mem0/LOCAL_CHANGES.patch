+
+    @staticmethod
+    def _is_retryable_error(error: Exception) -> bool:
+        status_code = getattr(error, "status_code", None)
+        if status_code in {429, 500, 502, 503, 504}:
+            return True
+        message = str(error).lower()
+        return any(
+            token in message
+            for token in ["429", "rate_limit", "too many requests", "timed out", "temporarily unavailable", "502", "503", "504"]
+        )
+
+    def _create_chat_completion_with_retry(self, params: Dict):
+        max_attempts = int(os.getenv("MEM0_LLM_MAX_RETRIES", "6"))
+        base_delay = float(os.getenv("MEM0_LLM_RETRY_BASE_DELAY", "10"))
+        for attempt in range(max_attempts):
+            try:
+                return self.client.chat.completions.create(**params)
+            except Exception as error:
+                if not self._is_retryable_error(error) or attempt == max_attempts - 1:
+                    raise
+                delay = base_delay * (2**attempt)
+                logging.warning(
+                    "Mem0 LLM retry %s/%s after error: %s. Sleeping %.1fs.",
+                    attempt + 1,
+                    max_attempts,
+                    error,
+                    delay,
+                )
+                time.sleep(delay)
